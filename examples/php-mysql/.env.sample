# Copy to .env and adjust. Never commit .env.

# Service
NOTES_PREFIX=notes
# Absolute base URL the browser uses to reach this module (HTTPS in production)
NOTES_PUBLIC_BASE_URL=http://localhost:8794

# Registration data - fill ONLY from the registration record, never guess
NOTES_MODULE_ID=0
NOTES_ALLOWED_DMN_IDS=
# The panel origin(s) allowed to call this module, comma separated
NOTES_ALLOWED_ORIGINS=
# The platform's shared stylesheet URL (empty = this module's demo stylesheet)
NOTES_STYLESHEET_URL=

# Authentication
CHECK_RKEY_API=https://api.trust-login.com/checkrkey/

# Local development only - both must be 0 in production
NOTES_MOCK_AUTH=1
NOTES_DEV_SHELL=1

# MySQL (docker compose sets NOTES_DB_HOST=db for the app container)
NOTES_DB_HOST=127.0.0.1
NOTES_DB_PORT=3306
NOTES_DB_NAME=notes
NOTES_DB_USER=notes
NOTES_DB_PASSWORD=change-me-locally
